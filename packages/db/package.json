{
  "name": "@syntara/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle-схема, миграции и seed (раздел 5 SPEC). Таблицы — итерация 2.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
