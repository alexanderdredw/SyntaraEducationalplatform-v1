{
  "name": "@syntara/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod-схемы DTO, перечисления, ключи конфигурации и i18n (раздел 2.2 SPEC)",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/esm/index.js",
      "default": "./dist/index.js"
    },
    "./i18n/*": "./i18n/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:sync": "node scripts/sync-needs-review.mjs"
  },
  "dependencies": {
    "intl-messageformat": "11.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
