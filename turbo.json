{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "SESSION_SECRET",
    "APP_BASE_URL",
    "API_INTERNAL_URL",
    "LLM_PROVIDER",
    "LLM_API_KEY",
    "LLM_MODEL",
    "SMTP_URL",
    "MAIL_FROM",
    "SUPPORT_EMAIL",
    "CLAMD_HOST",
    "OLEVBA_URL",
    "PLATFORM_TZ",
    "SENTRY_DSN",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "API_PORT",
    "TESTCONTAINERS_RYUK_DISABLED",
    "RATE_LIMITS_DISABLED",
    "SEED_DEV_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "openapi:generate": {
      "dependsOn": ["^build"],
      "outputs": ["openapi.json"]
    }
  }
}
