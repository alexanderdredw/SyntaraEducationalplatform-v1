# Локальная разработка. Секреты — только здесь (AG-10); файл .env не коммитится.
# Переменные раздела 2.3 SPEC.

# --- Инфраструктура docker compose (infra/docker-compose.yml) ---
POSTGRES_USER=syntara
POSTGRES_PASSWORD=syntara_dev_password
POSTGRES_DB=syntara
MINIO_ROOT_USER=syntara
MINIO_ROOT_PASSWORD=syntara_dev_password

# --- api, worker ---
# Через PgBouncer (session mode локально). Прямое подключение: порт 5432.
DATABASE_URL=postgres://syntara:syntara_dev_password@localhost:6432/syntara
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=syntara-files
S3_ACCESS_KEY=syntara
S3_SECRET_KEY=syntara_dev_password
# 64 случайных байта в hex: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-64-random-bytes-hex-change-me-to-64-random-bytes-hex-change-me-to-64-random
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
API_PORT=3001
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@syntara-edu.me
SUPPORT_EMAIL=support@syntara-edu.me
CLAMD_HOST=localhost:3310
OLEVBA_URL=http://localhost:8080
PLATFORM_TZ=Asia/Almaty
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
