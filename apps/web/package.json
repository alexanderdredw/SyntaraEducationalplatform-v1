{
  "name": "@syntara/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js: публичные страницы, кабинеты, служебная поддержка (раздел 2.2 SPEC)",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next dev -p 3000",
    "build": "next build",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start -p 3000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "openapi:types": "openapi-typescript ../api/openapi.json -o lib/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@sentry/nextjs": "^10.76.2",
    "@syntara/shared": "workspace:*",
    "@syntara/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
