    "/api/staff/tickets": {
      "get": {
        "operationId": "StaffTicketsController_list",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {}
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Номер обращения или email",
            "schema": {}
          },
          {
            "name": "dueBefore",
            "required": false,
            "in": "query",
            "description": "ISO 8601: срок первого ответа не позже",
            "schema": {}
          },
          {
            "name": "category",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "technical",
                "school_onboarding",
                "learning",
                "account_access",
                "data_privacy",
                "other"
              ],
              "type": "string"
            }
          },
          {
            "name": "assigneeId",
            "required": false,
            "in": "query",
            "description": "UUID или none",
            "schema": {}
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "new",
                "in_progress",
                "waiting_user",
                "waiting_internal",
                "resolved",
                "closed",
                "reopened"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Нет сессии"
          },
          "403": {
            "description": "Нет роли или неверный X-CSRF-Token"
          }
        },
        "security": [
          {
            "sid": []
          }
        ],
        "tags": [
          "staff"
        ]
      }
    },
