    "/api/public/school-requests": {
      "post": {
        "operationId": "FormsController_schoolRequest",
        "parameters": [
          {
            "name": "Accept-Language",
            "in": "header",
            "description": "Язык письма",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "UUID; тот же ключ и то же тело → прежний ответ (API-GEN-05)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SchoolRequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FormCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "VALIDATION_FAILED; fieldErrors — ключи i18n validation.*"
          },
          "409": {
            "description": "IDEMPOTENCY_MISMATCH"
          },
          "429": {
            "description": "Превышен лимит; retryAfterSeconds в теле"
          }
        },
        "tags": [
          "public"
        ]
      }
    },
