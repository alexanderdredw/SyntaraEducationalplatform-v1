  "info": {
    "title": "Syntara Education Platform API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sid"
      }
    },
    "schemas": {
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "redis": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "PreferencesDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "ru",
              "kk",
              "en"
            ]
          },
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "dataSaver": {
            "type": "boolean"
          }
        },
        "required": [
          "locale",
          "theme",
          "dataSaver"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "initials": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "student",
                "teacher",
                "support_agent",
                "onboarding_agent"
              ]
            }
          },
          "activeRole": {
            "type": "string",
            "enum": [
              "student",
              "teacher",
              "support_agent",
              "onboarding_agent"
            ]
          },
          "preferences": {
            "$ref": "#/components/schemas/PreferencesDto"
          }
        },
        "required": [
          "id",
          "displayName",
          "initials",
          "roles",
          "activeRole",
          "preferences"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeDto"
          }
        },
        "required": [
          "user"
        ]
      },
      "SchoolRequestBody": {
        "type": "object",
        "properties": {
          "schoolName": {
            "type": "string",
            "maxLength": 200
          },
          "region": {
            "type": "string",
            "maxLength": 120
          },
          "city": {
            "type": "string",
            "maxLength": 120
          },
          "contactPerson": {
            "type": "string",
            "maxLength": 200
          },
          "phone": {
            "type": "string",
            "example": "+7 700 000 00 00"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "message": {
            "type": "string",
            "maxLength": 5000
          }
        },
        "required": [
          "schoolName",
          "contactPerson",
          "email"
        ]
      },
      "FormCreatedResponse": {
        "type": "object",
        "properties": {
          "publicNumber": {
            "type": "string",
            "example": "SR-261014-0042"
          },
